{
  "manifest_version": 3,
  "name": "pin-pok",
  "version": "3.5.0",
  "description": "Подсказки к Hold'em: карты, диапазоны и эквити",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "*://e5t.online/*",
    "*://*.e5t.online/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "pin-pok — открыть виджет"
  },
  "content_scripts": [
    {
      "matches": ["*://e5t.online/*", "*://*.e5t.online/*"],
      "js": ["vision.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://e5t.online/*", "*://*.e5t.online/*"],
      "js": ["page_bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://e5t.online/*", "*://*.e5t.online/*"],
      "js": ["vision.js", "card_parser.js", "content_iframe.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["page_bridge.js"],
      "matches": ["*://e5t.online/*", "*://*.e5t.online/*"]
    }
  ]
}
